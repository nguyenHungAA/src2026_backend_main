{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [{ "src": "src/index.ts", "use": "@vercel/node" }],
  "routes": [{ "src": "/(.*)", "dest": "src/index.ts" }],
  "crons": [
    {
      "path": "/api/v1/maintenance/internal/run?emailLimit=10&mediaLimit=25",
      "schedule": "*/5 * * * *"
    }
  ]
}
